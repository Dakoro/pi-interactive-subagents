{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr or tmux",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dakoro/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts test/test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "test:herdr": "node --test test/integration/herdr-surface.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": "^1.3.27"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "typebox": "1.3.27"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
